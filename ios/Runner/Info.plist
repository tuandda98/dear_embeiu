<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS</key>
		<false/>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Dear Embeiu cần truy cập thư viện ảnh để bạn chọn và chia sẻ ảnh kỷ niệm với người ấy.</string>
		<key>NSHealthShareUsageDescription</key>
		<string>Dear Embeiu đọc giấc ngủ mà iPhone hoặc Apple Watch đã ghi trong app Sức khoẻ, để hiện giờ ngủ, giờ dậy và những lần bạn thức giấc trong đêm. Bật chia sẻ thì người ấy cũng xem được. App chỉ đọc, không ghi gì vào Sức khoẻ.</string>
		<key>NSHealthUpdateUsageDescription</key>
		<string>Dear Embeiu không ghi gì vào app Sức khoẻ. App chỉ đọc giấc ngủ để hiện giờ ngủ và giờ dậy của bạn.</string>
		<key>NSMotionUsageDescription</key>
		<string>Dear Embeiu xem điện thoại nằm yên lúc nào vào ban đêm để đoán giờ bạn ngủ và thức. Dữ liệu chuyển động thô chỉ nằm trên máy; giờ ngủ và giờ thức chỉ được gửi cho người ấy khi bạn bật chia sẻ.</string>
		<key>NSCameraUsageDescription</key>
		<string>Dear Embeiu cần dùng camera để bạn chụp và đăng khoảnh khắc kỷ niệm với người ấy.</string>
		<!-- ── arrival (đợt 2) ── D12; no UIBackgroundModes location (spike §6.6). -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Dear Embeiu đọc vị trí khi bạn chọn “Dùng vị trí hiện tại” để lưu một nơi, và để nhận ra khi bạn đến nơi đó. Toạ độ chỉ nằm trên máy bạn.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Để báo người ấy khi bạn đến nơi, kể cả lúc app đang đóng. App chỉ gửi tên nơi đến, giờ và mức pin, không gửi toạ độ.</string>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>vi</string>
		</array>
		<key>CFBundleAllowMixedLocalizations</key>
		<true/>
		<key>CFBundleDisplayName</key>
		<string>$(APP_DISPLAY_NAME)</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>$(APP_DISPLAY_NAME)</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<!-- Custom URL scheme so the branded email action page
		     (docs/auth-action.html) can foreground the app after the user
		     verifies their email / resets their password in the browser.
		     The app only needs to come to the foreground — VerifyEmailScreen
		     auto-polls on resume and advances on its own. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.tony.dearembeiu</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>dearembeiu</string>
				</array>
			</dict>
			<!-- Google sign-in (pairing-funnel PF14) returns to the app through
			     the REVERSED_CLIENT_ID of GoogleService-Info.plist. The build
			     copies the DEV or PROD plist, so both schemes are listed. -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>google-sign-in</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.529060310047-u3iur17juokp95cgtnov063s5dj03llk</string>
					<string>com.googleusercontent.apps.478033104351-83r17l3e1o4cvegogi330telu8b9oar8</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>AppGroupId</key>
		<string>$(APP_GROUP_ID)</string>
		<!-- The app never reads a dearembeiu:// URL — opening one only has to
		     bring the app forward. Flutter's own deep linking would push a
		     second "/" route (audit D8). Plugins still see openURL first. -->
		<key>FlutterDeepLinkingEnabled</key>
		<false/>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- Phones stay portrait (audit D3: the time pickers break in
		     landscape); iPad keeps every orientation below. -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
