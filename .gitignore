#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/functions/node_modules/

# Firebase rules unit tests (Node project) + emulator artifacts
/firebase_rules_test/node_modules/
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log
firebase-export-*/
.firebase_rules_test.cache

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# Android signing — never commit these
*.jks
*.keystore
android/key.properties

# Apple keys / secrets — never commit these
AuthKey_*.p8
*.p8

# Active iOS Firebase config is build-managed: the "Select GoogleService-Info (env)"
# build phase overwrites it each build from ios/config/{dev,prod}/ by $CONFIGURATION.
# Source of truth = ios/config/ (committed). Don't track the flip-flopping working copy.
ios/Runner/GoogleService-Info.plist

# Figma integration — chứa API token, không commit
.env.figma
figma_screenshots/
# Trang sinh nhật riêng tư — deploy thẳng lên Firebase Hosting site
# "dearembeiu-birthday", TUYỆT ĐỐI không commit (repo này public).
docs/birthday/

# cache deploy của Firebase CLI
.firebase/
