<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background = CounterCard sunsetRomance (#FF6B9D→#FF8FA3→#FFB6C1) +
     scrim .08→.36 (2026-10-12: the old #FF5C8F→#E63956 was darker than anything
     in the app). Shown when the couple has no photo yet, or the file is missing. Angle 315
     = top-left → bottom-right in Android's counter-clockwise convention. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:centerColor="#FF8FA3"
                android:endColor="#FFB6C1"
                android:startColor="#FF6B9D"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:endColor="#5C000000"
                android:startColor="#14000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Aurora glows live INSIDE the background so every API level clips them
         to the rounded corners (clipToOutline is API 31+). -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:centerX="0.0"
                android:centerY="0.0"
                android:endColor="#00FFFFFF"
                android:gradientRadius="56dp"
                android:startColor="#42FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:centerX="1.0"
                android:centerY="1.0"
                android:endColor="#00A78BFA"
                android:gradientRadius="72dp"
                android:startColor="#66A78BFA"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
