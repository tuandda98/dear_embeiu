<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget 2×2 (feature home-widget, design.md hướng A). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Couple photo (feature home-widget, 2026-10-12): native sets the bitmap
         with rounded corners baked in; GONE = brand gradient from widget_bg. -->
    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- FrameLayout, not View: RemoteViews refuses to inflate android.view.View. -->
    <FrameLayout
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/widget_chip_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_name1"
                android:text="@string/widget_preview_name1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:maxWidth="48dp"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#1A1A2E"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/widget_heart"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_heart" />

            <TextView
                android:id="@+id/widget_name2"
                android:text="@string/widget_preview_name2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:maxWidth="48dp"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#1A1A2E"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_days"
            android:text="@string/widget_preview_days"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:autoSizeMaxTextSize="40sp"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="bottom|start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.025"
            android:maxLines="1"
            android:shadowColor="#4D000000"
            android:shadowDy="1"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/widget_caption"
            android:text="@string/widget_preview_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:shadowColor="#47000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="#EBFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
