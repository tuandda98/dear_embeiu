<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget 4×2: counter column + milestone column. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Couple photo (feature home-widget, 2026-10-12): native sets the bitmap
         with rounded corners baked in; GONE = brand gradient from widget_bg. -->
    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- FrameLayout, not View: RemoteViews refuses to inflate android.view.View. -->
    <FrameLayout
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim"
        android:visibility="gone" />

    <!-- Night-sky default (design M2): stars + heart constellation; hidden when a photo shows. -->
    <ImageView
        android:id="@+id/widget_stars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/widget_stars" />

    <ImageView
        android:id="@+id/widget_sky"
        android:layout_width="52dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_constellation" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/widget_chip"
                android:layout_height="20dp"
                android:background="@drawable/widget_chip_bg_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/widget_name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:maxWidth="64dp"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/widget_heart"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_heart_light" />

                <TextView
                    android:id="@+id/widget_name2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:maxWidth="64dp"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_days"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:gravity="bottom|start"
                android:includeFontPadding="false"
                android:letterSpacing="-0.025"
                android:maxLines="1"
                android:shadowColor="#4D000000"
                android:shadowDy="1"
                android:shadowRadius="8"
                android:textColor="#FFFFFF"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/widget_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:shadowColor="#47000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="#EBFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="2dp"
            android:background="#47FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 2 lines + paddingEnd 48dp: the constellation sits top-right (design M2). -->
            <TextView
                android:id="@+id/widget_milestone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:lineSpacingExtra="-1sp"
                android:maxLines="2"
                android:paddingEnd="48dp"
                android:shadowColor="#47000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- RemoteViews cannot swap a progressDrawable: one bar per state. -->
            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress_dark" />

            <ProgressBar
                android:id="@+id/widget_progress_light"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_days_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:shadowColor="#47000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="#EBFFFFFF"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_since"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:shadowColor="#47000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="#D6FFFFFF"
                android:textSize="11sp" />

            <!-- "Hôm nay" line (feature widget-today, design §5.5): replaces
                 widget_since when shown. GONE = 1.9.1 layout. -->
            <LinearLayout
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_status_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:paddingTop="6dp"
                    android:src="@drawable/widget_status_dot" />

                <TextView
                    android:id="@+id/widget_status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:shadowColor="#4D000000"
                    android:shadowDy="1"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
