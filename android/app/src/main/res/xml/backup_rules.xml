<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older (android:fullBackupContent). Same exclusions as
  data_extraction_rules.xml: sleep data never leaves the phone (audit D6).
-->
<full-backup-content>
    <exclude domain="root" path="app_flutter/sleep_nobackup/" />
    <exclude domain="root" path="app_flutter/sleep_local.hive" />
    <!-- ── arrival (đợt 2) ── places + coordinates stay on this phone (D2). -->
    <exclude domain="root" path="app_flutter/arrival_nobackup/" />
    <!-- ── arrival (đợt 2) ── native_geofence keeps each region (lat/lng) in its
         own prefs file: off the backup too (D2). -->
    <exclude domain="sharedpref" path="native_geofence_plugin_cache.xml" />
    <exclude domain="sharedpref" path="dear_embeiu_motion.xml" />
</full-backup-content>
