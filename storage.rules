rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User must be signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // For couple photos - check that user is authenticated
    // Note: Detailed authorization is handled in Firestore rules
    // Storage path format: couple_photos/{coupleId}/{fileName}
    match /couple_photos/{coupleId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth != null
        && coupleId is string
        && coupleId.size() > 0;
      allow delete: if isSignedIn();
    }
  }
}

